{
	"manifest_version": 2.0,
	"id": "monitor_docker",
	"type": "module",
	"name": "Docker Monitoring",
	"namespace": "MonitorDocker",
	"version": "1.3",
	"author": "Manuel Pesenti",
	"description": "Docker container overview and per-container metrics collected by Zabbix agent 2.",
	"actions": {
		"docker.list": {
			"class": "CControllerDockerList",
			"view": "docker.list",
			"layout": "layout.htmlpage"
		},
		"docker.view": {
			"class": "CControllerDockerView",
			"view": "docker.view",
			"layout": "layout.htmlpage"
		},
		"docker.images.csv": {
			"class": "CControllerDockerImagesCsv",
			"view": "docker.images.csv",
			"layout": "layout.csv"
		},
		"docker.problems": {
			"class": "CControllerDockerProblems",
			"layout": "layout.json"
		},
		"docker.sparkline": {
			"class": "CControllerDockerSparkline",
			"layout": "layout.json"
		},
		"docker.tab": {
			"class": "CControllerDockerTab",
			"layout": "layout.json"
		},
		"docker.container": {
			"class": "CControllerDockerContainer",
			"layout": "layout.json"
		},
		"docker.integration": {
			"class": "CControllerDockerIntegration",
			"layout": "layout.json"
		}
	},
	"assets": {
		"css": ["blue-theme.css", "dark-theme.css"],
		"js": ["integrations.js"]
	}
}
